# ============================================================
# .env.example - Environment variables (copy to .env)
# By Angga Official
# ============================================================

# Nomor owner (format 62xxx, tanpa + atau spasi)
OWNER_NUMBER=62895411941384

# Pairing code number (default: pakai OWNER_NUMBER)
PAIRING_NUMBER=62895411941384

# Bot name
BOT_NAME=Angga Bot
BRANDING=Angga Official

# Pterodactyl Panel config (opsional - kalau pakai fitur panel)
PTERO_DOMAIN=https://panel.kamu.com
PTERO_DOMAIN2=panel.kamu.com
PTERO_APIKEY=ptla_xxxxxxxx
PTERO_CAPIKEY=ptlc_xxxxxxxx
PTERO_EGG=5
PTERO_LOC=1

# Payment (opsional)
DANA=
OVO=
GOPAY=
SHOPEEPAY=
QRIS=
BRI=

# Bot behavior
AUTOREAD=false
ANTICALL=false
WELCOME=false
SELF_MODE=false

# Delays
DELAY_JPM=4000
DELAY_PUSHKONTAK=3000
